<?xml version="1.0" encoding="UTF-8"?>
<!--
    log4j2-spring.xml — version SANS archivage automatique.

    Changement demandé par l'encadreur : on retire le RollingFileAppender
    (qui créait des .gz compressés par jour) au profit d'un simple
    <File> appender : un seul fichier plat, jamais renommé ni compressé
    automatiquement. Le "par jour" demandé se fait maintenant au niveau
    du RAPPORT (rapport_analyses_AAAA-MM-JJ.log dans run_and_analyze.py),
    pas au niveau du log brut de l'application.
-->
<Configuration status="WARN">

    <Properties>
        <Property name="MOTIF">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n%throwable</Property>
    </Properties>

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${MOTIF}"/>
        </Console>

        <!-- Fichier plat, sans rotation ni archivage -->
        <File name="Fichier" fileName="logs/petclinic.log">
            <PatternLayout pattern="${MOTIF}"/>
        </File>

    </Appenders>

    <Loggers>
        <Logger name="org.springframework.samples.petclinic" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Fichier"/>
        </Logger>

        <Logger name="org.springframework" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Fichier"/>
        </Logger>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Fichier"/>
        </Root>
    </Loggers>

</Configuration>